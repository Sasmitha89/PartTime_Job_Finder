PORT=5000

# From Supabase: Project Settings -> Database -> Connection string -> URI
# (fill in the password you set when creating the project)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

JWT_SECRET=your_jwt_secret_here

# From Supabase: Project Settings -> API Keys
# SUPABASE_URL looks like https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is the SECRET service_role key — never expose this to the frontend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
