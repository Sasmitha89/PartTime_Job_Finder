PORT=5000

# From Supabase: Project Settings -> Database -> Connection string -> URI
# (fill in the password you set when creating the project)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

JWT_SECRET=your_jwt_secret_here

# From Supabase: Project Settings -> API Keys
# SUPABASE_URL looks like https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is the SECRET service_role key — never expose this to the frontend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Password reset emails — OPTIONAL. If left blank, reset links are
# printed to the server console instead of emailed, so you can still
# test the whole flow before setting up real email.
#
# Example using Gmail SMTP (requires a Google "App Password", not your
# normal Gmail password — see README for how to generate one):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM=youraddress@gmail.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Where your frontend is served from, used to build the link inside
# password reset emails. If you open Client/index.html with the VS Code
# "Live Server" extension, this is usually http://127.0.0.1:5500
CLIENT_URL=http://127.0.0.1:5500
